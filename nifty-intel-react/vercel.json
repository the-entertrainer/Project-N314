{
  "buildCommand": "npm run build",
  "framework": "vite",
  "outputDirectory": "./dist",
  "env": [
    {
      "key": "VITE_GEMINI_API_KEY",
      "description": "Gemini API key for AI sentiment and analysis"
    },
    {
      "key": "VITE_NEWS_API_KEY",
      "description": "News API key for market news integration (optional)",
      "value": ""
    }
  ],
  "github": {
    "enabled": true,
    "automatic": true,
    "deploymentEnabled": true,
    "productionBranch": "main"
  },
  "regions": [
    "iad1"
  ]
}
